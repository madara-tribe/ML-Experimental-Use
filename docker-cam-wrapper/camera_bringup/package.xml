<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>camera_bringup</name>
  <version>0.0.1</version>
  <description>ROS2 launch package for camera pub/sub system</description>

  <maintainer email="developer@todo.todo">developer</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>camera_publisher</exec_depend>
  <exec_depend>camera_subscriber</exec_depend>
  <exec_depend>camera_publisher_cpp</exec_depend>
  <exec_depend>camera_subscriber_cpp</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
